# Copie para .env e TROQUE tudo. Nunca versione o .env.
POSTGRES_PASSWORD=troque-esta-senha-longa
AVENTURAS_CLASS_CODE=ESCOLHA-O-CODIGO-DA-TURMA      # alunos digitam ao criar conta
AVENTURAS_TUTOR_CODE=ESCOLHA-OUTRO-CODIGO-SECRETO   # só você e o Hernandes
DOMAIN=aventuras.educodemaraba.com.br               # só no modo HTTPS
AVENTURAS_COOKIE_SECURE=true                        # true com HTTPS; false na rede local (http)

# Surpresa (opcional): substitui o conteúdo padrão do selo da Era 1
# AVENTURAS_UNLOCK_WORDS=dividir,padrão,essencial,passos
# AVENTURAS_UNLOCK_TEMPLATE=Para vencer um problema grande, eu ___ em partes, procuro o ___, guardo só o ___ e escrevo os ___.
# AVENTURAS_REWARD_TITLE=O Selo do Cartógrafo
# AVENTURAS_REWARD_TEXT=Vocês decifraram o primeiro selo! ...

# VPS com HTTPS (Caddy): 127.0.0.1 impede o acesso direto à porta 8000 (o Docker ignora o ufw).
# Rede local (Mac): deixe 0.0.0.0.
APP_BIND=127.0.0.1
